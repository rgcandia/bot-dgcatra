# Puerto
PORT=4002

# Base de datos (usadas por docker-compose y la app)
POSTGRES_USER=dgcatra
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=dgcatra
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# JWT (cambiarlo en producción)
JWT_SECRET=

# Super Admin (teléfono con código de país, ej: 5491112345678)
SUPER_ADMIN_PHONE=

# Código maestro de acceso (backup si no llega el OTP por WhatsApp)
MASTER_CODE=

# Groq API (IA para generar títulos de tickets, opcional)
GROQ_API_KEY=
